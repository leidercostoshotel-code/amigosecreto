rules_version = '2';

// Reglas de seguridad del Amigo Secreto.
// Modelo:
//  - El ADMIN inicia sesión con correo/contraseña y es dueño de su(s) juego(s).
//  - Los JUGADORES entran de forma anónima (Anonymous Auth) y solo pueden
//    "reclamar" su nombre una vez (fijar su PIN) y marcarse como visto.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Lista de integrantes guardados: privada de cada admin.
    match /admins/{adminUid} {
      allow read, write: if signedIn() && request.auth.uid == adminUid;
      match /people/{personId} {
        allow read, write: if signedIn() && request.auth.uid == adminUid;
      }
    }

    function gameData(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data;
    }
    function isGameAdmin(gameId) {
      return signedIn() && gameData(gameId).adminUid == request.auth.uid;
    }

    match /games/{gameId} {
      // El título y el estado son públicos (los jugadores los necesitan).
      allow read: if true;

      // Crear: quien lo crea queda registrado como admin.
      allow create: if signedIn()
                    && request.resource.data.adminUid == request.auth.uid
                    && request.resource.data.status in ['setup', 'drawn'];

      // Solo el admin dueño puede modificar o borrar el juego.
      allow update, delete: if isGameAdmin(gameId);

      match /players/{playerId} {
        // Los nombres se leen para mostrar la lista. (El receptor también queda
        // legible; la privacidad real frente a otros jugadores la da el PIN en
        // la app. Para ocultarlo también a nivel de base de datos haría falta
        // un código privado por persona o Cloud Functions.)
        allow read: if true;

        // Crear y borrar jugadores: solo el admin.
        allow create, delete: if isGameAdmin(gameId);

        // Actualizar: el admin puede todo. Un jugador autenticado solo puede:
        //  (a) reclamar su nombre UNA vez (fijar pinHash/pinSalt) y marcarse visto,
        //  (b) editar su lista de deseos (solo el campo 'wishlist'),
        //  (c) marcar/desmarcar "comprado" en la lista de deseos de cualquiera
        //      (solo el campo 'boughtMarks', es su propia anotación privada), o
        //  (d) dejarle una nota anónima a otra persona (solo el campo
        //      'notesForMe', y solo puede crecer, con un tope de 20 notas).
        // En todos los casos sin tocar el nombre, el receptor ni el orden.
        allow update: if isGameAdmin(gameId) || (
          signedIn()
          && request.resource.data.name == resource.data.name
          && request.resource.data.receiver == resource.data.receiver
          && request.resource.data.order == resource.data.order
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['pinHash', 'pinSalt', 'revealed'])
          && resource.data.pinHash == null
          && request.resource.data.revealed == true
        ) || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wishlist'])
        ) || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boughtMarks'])
          && request.resource.data.boughtMarks is map
          && request.resource.data.boughtMarks.size() <= 200
        ) || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notesForMe'])
          && request.resource.data.notesForMe is list
          && request.resource.data.notesForMe.size() <= 20
          // Solo puede crecer (no borrar mensajes ajenos). Trata como 0 si antes
          // no era una lista (ausente o null), evitando errores de evaluación.
          && request.resource.data.notesForMe.size()
               >= ((('notesForMe' in resource.data) && resource.data.notesForMe is list)
                     ? resource.data.notesForMe.size() : 0)
        );
      }
    }
  }
}
